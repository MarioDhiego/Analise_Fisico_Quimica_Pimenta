baseline_c <- df_cinzas_limpo %>% filter(Pimenta == "In Natura", Meses == "Fevereiro")
media_c <- mean(baseline_c$Cinzas, na.rm = TRUE)
sd_c <- sd(baseline_c$Cinzas, na.rm = TRUE)
LSC_c <- media_c + (3 * sd_c)
LIC_c <- media_c - (3 * sd_c)
df_medias_c <- df_cinzas_limpo %>% filter(Pimenta == "In Natura") %>%
group_by(Meses) %>% summarise(Media = mean(Cinzas, na.rm=TRUE), SD = sd(Cinzas, na.rm=TRUE), .groups="drop")
ggplot(df_medias_c, aes(x = Meses, y = Media, group = 1)) +
annotate("rect", xmin = -Inf, xmax = Inf, ymin = LIC_c, ymax = LSC_c, fill = "gray70", alpha = 0.3) +
geom_ribbon(aes(ymin = Media - SD, ymax = Media + SD, fill = "Zona de Estabilidade"), alpha = 0.2) +
geom_hline(aes(yintercept = media_c, color = "Média"), linetype = "dashed", size = 0.8) +
geom_hline(aes(yintercept = LSC_c, color = "LSC"), linetype = "dotted", size = 1) +
geom_hline(aes(yintercept = LIC_c, color = "LIC"), linetype = "dotted", size = 1) +
geom_line(color = "blue", size = 1.2) +
geom_point(size = 4, shape = 21, fill = "blue", color = "white", stroke = 1.2) +
scale_color_manual(name = "Legendas", values = c("Média" = "darkgreen", "LSC" = "red", "LIC" = "red")) +
scale_fill_manual(name = "Dispersão", values = c("Zona de Estabilidade" = "blue")) +
labs(title = "Gráfico de Controle de Estabilidade - Cinzas (In Natura)", x = "Mês", y = "Cinzas (%)") +
theme_bw() + theme(legend.position = "bottom")
